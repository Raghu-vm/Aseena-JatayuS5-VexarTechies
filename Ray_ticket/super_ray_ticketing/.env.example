################################################################################
# SUPER RAY TICKETING - ENVIRONMENT TEMPLATE
# Copy to .env and fill in the values. Never commit your real .env.
################################################################################

# --- App ---
ENV=dev
PROJECT_NAME=Super Ray Ticketing
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8003

# --- JWT (reserved; current auth model uses simple email lookup) ---
SECRET_KEY=CHANGE_ME_to_32+_random_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# --- Database (Neon / any Postgres) ---
POSTGRES_DSN=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
POSTGRES_SYNC_DSN=postgresql+psycopg2://USER:PASSWORD@HOST/DB?sslmode=require
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ticketing_test

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# Optional overrides:
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# --- Gemini ---
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2

# --- SMTP ---
# For Gmail: enable 2FA, then create an App Password and put it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=AI Ticketing Assistant <noreply@example.com>

# --- Department email routing ---
# For demo, all departments fall back to DEFAULT_DEPARTMENT_EMAIL.
# To route per-department in production, set each one individually.
DEFAULT_DEPARTMENT_EMAIL=raghunath11112004@gmail.com
# IT_SUPPORT_EMAIL=
# HUMAN_RESOURCES_EMAIL=
# FINANCE_EMAIL=
# OPERATIONS_EMAIL=
# SALES_EMAIL=
# ENGINEERING_EMAIL=

# --- CORS (JSON list or comma-separated) ---
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000","http://localhost:8003"]

# --- Rate limits & SLA ---
RATE_LIMIT=10/minute
SLA_DEFAULT_MINUTES=2880
MAX_INPUT_CHARS=4000

# --- Gmail OAuth (optional, not used by current flow) ---
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_TOKEN_ENCRYPTION_KEY=
# GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
# GMAIL_SYSTEM_REDIRECT_URI=http://localhost:8000/api/v1/gmail/system/callback
